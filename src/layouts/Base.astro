---
import '../styles/global.css';
import { url, SITE_NAME } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = 'Candidates, constitutional amendments, and arguments for and against everything on the November 3, 2026 Tennessee ballot, shown without party or group labels.',
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: url('amendments'), label: 'Amendments' },
  { href: url('races'), label: 'Races' },
  { href: url('districts'), label: 'Find your districts' },
  { href: url('method'), label: 'How this guide works' },
];
const isHome = title === 'Home';
const pageTitle = isHome ? 'Tennessee 2026 Ballot Guide: Candidates and Amendments' : `${title} · ${SITE_NAME}`;
const canonical = new URL(path, Astro.site).href;
const socialImage = new URL(url('og-image.png').replace(/\/$/, ''), Astro.site).href;
// Structured data for search engines: the site itself, on the home page only.
const jsonLd = isHome
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL('/', Astro.site).href, description, inLanguage: 'en-US' }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={isHome ? pageTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: what's on the November 3, 2026 Tennessee ballot`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('sitemap-index.xml').replace(/\/$/, '')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url()}>{SITE_NAME}</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>Not affiliated</strong> with any party, campaign, candidate, or government agency. This is not voting
          advice: the guide never tells you how to vote. Arguments are paraphrased from published sources and shown
          without labels; see <a href={url('method')}>how this guide works</a>.
        </p>
        <p>
          Spotted an error or a missing argument? <a href={url('contact')}>Contact us</a> (corrections need a source
          link).
        </p>
      </div>
    </footer>
    <script>
      // Mobile tabs for argument columns. Without JS both columns simply stack.
      for (const group of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
        const buttons = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const panels = [...group.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
        const select = (i: number, focus = false) => {
          buttons.forEach((b, j) => {
            b.setAttribute('aria-selected', String(i === j));
            b.tabIndex = i === j ? 0 : -1;
            panels[j].classList.toggle('active', i === j);
          });
          if (focus) buttons[i].focus();
        };
        buttons.forEach((b, i) => {
          b.addEventListener('click', () => select(i));
          b.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
              e.preventDefault();
              select((i + (e.key === 'ArrowRight' ? 1 : buttons.length - 1)) % buttons.length, true);
            }
          });
        });
        select(0);
      }
      // Open the collapsed sources list when a footnote marker is followed.
      const openSources = () => {
        const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
        target?.closest('details')?.setAttribute('open', '');
      };
      addEventListener('hashchange', openSources);
      openSources();
    </script>
  </body>
</html>
