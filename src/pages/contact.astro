---
import Base from '../layouts/Base.astro';
import { url, CONTACT_EMAIL, CONTACT_ENDPOINT, TURNSTILE_SITE_KEY } from '../lib/site';
---

<Base title="Contact" description="Send a correction, a missing argument, or a question about the TN 2026 Ballot Guide.">
  <h1>Contact</h1>
  <p class="lede">Corrections, missing arguments, and questions are welcome.</p>
  <p>
    Corrections and additions follow the same rules as everything else in the guide: include a link to the published
    source, and remember that arguments are shown without labels and platforms come only from a candidate's own
    materials. See <a href={url('method')}>how this guide works</a>.
  </p>

  <form class="contact-form" id="contact-form" action={CONTACT_ENDPOINT} method="post">
    <label>
      <span>What is this about?</span>
      <select name="topic">
        <option value="correction">A correction</option>
        <option value="missing">A missing argument or platform</option>
        <option value="question">A question</option>
        <option value="other">Something else</option>
      </select>
    </label>
    <label>
      <span>Message <small class="muted">(required)</small></span>
      <textarea name="message" rows="7" maxlength="5000" required></textarea>
    </label>
    <label>
      <span>Source link <small class="muted">(required for corrections and additions)</small></span>
      <input type="url" name="source" maxlength="500" placeholder="https://" />
    </label>
    <label>
      <span>Your name <small class="muted">(optional)</small></span>
      <input type="text" name="name" maxlength="100" autocomplete="name" />
    </label>
    <label>
      <span>Your email <small class="muted">(optional, only if you'd like a reply)</small></span>
      <input type="email" name="email" maxlength="200" autocomplete="email" />
    </label>
    <label class="hp" aria-hidden="true">
      <span>Leave this empty</span>
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <input type="hidden" name="page" />
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
    <button type="submit">Send message</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>

  <p class="muted">
    Prefer email? Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Your message and any contact details
    are used only to respond to you and are never published.
  </p>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector<HTMLElement>('.form-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const page = form.elements.namedItem('page') as HTMLInputElement;
  page.value = document.referrer.startsWith(location.origin) ? document.referrer : '';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    button.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const out = await res.json().catch(() => ({ ok: false }));
      if (out.ok) {
        form.reset();
        status.textContent = 'Thanks. Your message was sent.';
      } else {
        status.textContent = out.error ?? 'Something went wrong. Please try again, or email us instead.';
      }
    } catch {
      status.textContent = 'The message could not be sent. Please check your connection, or email us instead.';
    }
    (window as any).turnstile?.reset();
    button.disabled = false;
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    margin: 1.5rem 0;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  label {
    display: grid;
    gap: 0.3rem;
  }
  label > span {
    font-weight: 600;
  }
  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 0.6rem;
  }
  textarea {
    resize: vertical;
  }
  button {
    justify-self: start;
    font: inherit;
    font-weight: 600;
    color: var(--bg);
    background: var(--ink);
    border: 0;
    border-radius: 6px;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .form-status:empty {
    display: none;
  }
  .form-status {
    margin: 0;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
